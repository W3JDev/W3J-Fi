{
  "version": 2,
  "name": "w3jdev-united",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_BASE_URL": "@base_url"
  },
  "build": {
    "env": {
      "VITE_BASE_URL": "@base_url"
    }
  }
}
